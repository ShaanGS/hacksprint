# Copy this file to apps/web/.env.local and fill it in. Never commit .env.local.
# `pnpm dev` refuses to start until the App, Supabase, Gemini and Sarvam values are all set.

# Public base URL of the app. Paytm calls back here and QR codes will point here.
# Local: http://localhost:3000. Deployed: the Vercel https URL.
APP_URL=http://localhost:3000

# The owner app's PIN (4 digits), and the secret that signs session cookies: openssl rand -hex 32
OWNER_PIN=
SESSION_SECRET=
# Scripts and n8n send it as "Authorization: Bearer ...": openssl rand -hex 32
SHOP_TOKEN=

# Stage only: "true" turns on the mark-paid fallback, POST /api/demo/reset and the demo label.
DEMO_MODE=true
# The demo's first late payer gets this WhatsApp number on reset, e.g. +919876543210.
DEMO_PAYER_PHONE=

# Supabase: dashboard > Project Settings > API Keys (URL under Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security; never use it in browser code.
SUPABASE_SECRET_KEY=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Flash-Lite: the free tier allows only 20 requests a day on gemini-3.8-flash, which a demo
# day runs through. Models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Sarvam: https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3

# Paytm staging: https://dashboard.paytmpayments.com/next/apikeys (test keys)
# Checked only when a Paytm call is made, because keys may arrive late.
PAYTM_BASE_URL=https://securestage.paytmpayments.com
PAYTM_MID=
PAYTM_MERCHANT_KEY=

# n8n (from milestone 4): webhook base URL, and a shared secret from `openssl rand -hex 32`
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
