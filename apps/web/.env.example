# Copy this file to apps/web/.env.local and fill it in. Never commit .env.local.
# `pnpm dev` refuses to start until the App, Supabase, Gemini and Sarvam values are set.

# Public base URL of the app. Paytm calls back here and QR codes will point here.
# Local: http://localhost:3000. Deployed: the Vercel https URL.
APP_URL=http://localhost:3000

# Supabase: dashboard > Project Settings > API Keys (URL under Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security; never use it in browser code.
SUPABASE_SECRET_KEY=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current stable Flash model: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Sarvam: https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3

# Paytm staging: https://dashboard.paytmpayments.com/next/apikeys (test keys)
# Checked only when a Paytm call is made, because keys may arrive late.
PAYTM_BASE_URL=https://securestage.paytmpayments.com
PAYTM_MID=
PAYTM_MERCHANT_KEY=

# n8n (from milestone 4): webhook base URL, and a shared secret from `openssl rand -hex 32`
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
